# Copy to .env and fill in real values for local development.

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database ---
# When using docker-compose.yml at the repo root, the defaults below match.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=cobra
DATABASE_PASSWORD=cobra
DATABASE_NAME=cobra_pets

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_COST=10

# --- CORS ---
# '*' (default) allows any origin — fine for dev. In production, set to the
# exact frontend origin, e.g. CORS_ORIGIN=https://adopt.example.com
# Comma-separated list also supported: CORS_ORIGIN=https://a.com,https://b.com
CORS_ORIGIN=*
